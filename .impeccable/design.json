      "css": ".ds-nav{display:flex;align-items:center;justify-content:flex-start;gap:4px;flex:0 1 auto;margin-inline:auto;min-width:0;padding:4px;border-radius:999px;background:var(--surface,#f5f5f6);font-family:Inter,Arial,sans-serif}.ds-nav button{min-height:34px;border:0;border-radius:99px;background:none;padding:9px 13px;font:11px Inter,Arial,sans-serif;color:#26272b;cursor:pointer;white-space:nowrap}.ds-nav .ds-current{background:#fff;color:var(--red,#d92742);box-shadow:0 2px 6px #34303b03}.ds-nav button:hover{color:var(--red,#d92742)}.ds-nav button:focus-visible{outline:3px solid #ac2346;outline-offset:4px}@media(max-width:650px){.ds-nav{overflow-x:auto;gap:1px}.ds-nav button{min-height:44px;padding:8px 13px}}"
