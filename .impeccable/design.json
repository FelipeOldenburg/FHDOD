      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:999px;min-height:38px;padding:10px 19px;background:var(--red,#d92742);color:#fff;font:500 12px/1.4 Inter,Arial,sans-serif;cursor:pointer;transition:background .18s,transform .18s}.ds-primary:hover:not(:disabled){background:var(--red-dark,#b91e36)}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid #ac2346;outline-offset:4px}"
