      "css": ".ds-field{display:flex;flex-direction:column;gap:9px;color:#64646c;font:12px Inter,Arial,sans-serif}.ds-field>span{font-weight:500}.ds-input{min-width:0;width:100%;min-height:42px;border:1px solid transparent;border-radius:10px;padding:11px 14px;background:#f6f6f7;color:#303037;font:13px Inter,Arial,sans-serif;caret-color:var(--red,#d92742);transition:border-color .2s}.ds-input:hover{border-color:#dbd8dc}.ds-input:focus{outline:0;border-color:var(--red,#d92742);box-shadow:0 0 0 3px #d9274210}.ds-input::placeholder{color:var(--muted,#686a73)}.ds-input:disabled{color:#65616a;opacity:.8}@media(max-width:650px){.ds-input{min-height:44px}}"
