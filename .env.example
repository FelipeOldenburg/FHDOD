# Copie para .env e informe a conexão do PostgreSQL. Não versione credenciais reais.
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/fhdod

# Docker Compose: banco interno. A senha é passada separadamente da URL.
# Use uma senha longa; coloque-a entre aspas simples se incluir $ ou #.
# POSTGRES_PASSWORD=
# POSTGRES_USER=fhdod
# POSTGRES_DB=fhdod
# FHDOD_HTTP_PORT=3001

# Publicação atrás de um proxy HTTPS, configurado pelo responsável do servidor.
# FHDOD_ORIGIN=https://hospital.example
# FHDOD_COOKIE_SECURE=1

# Fora do Docker, o servidor continua local por padrão.
# HOST=127.0.0.1

# Bancos separados; configure apenas quando usar demonstração ou testes.
# FHDOD_DEMO_DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/fhdod_demo
# FHDOD_TEST_DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/fhdod_test
